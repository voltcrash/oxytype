{
  "name": "oxytype",
  "version": "26.32.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "full-check": "turbo lint build test integration-test lint-styles lint-json check-assets --force",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "ts-check": "turbo run ts-check",
    "lint": "turbo run lint",
    "lint-check-config": "node packages/oxlint-config/check-application-defaults.ts",
    "lint-be": "turbo run lint --filter @oxytype/backend",
    "lint-fe": "turbo run lint --filter @oxytype/frontend",
    "lint-pkg": "turbo run lint --filter=\"./packages/*\"",
    "lint-fix": "turbo run lint -- --fix",
    "lint-fast": "turbo run lint-fast",
    "lint-fast-be": "turbo run lint-fast --filter @oxytype/backend",
    "lint-fast-fe": "turbo run lint-fast --filter @oxytype/frontend",
    "lint-fast-pkg": "turbo run lint-fast --filter=\"./packages/*\"",
    "build": "turbo run build",
    "build-be": "turbo run build --filter @oxytype/backend",
    "build-fe": "turbo run build --filter @oxytype/frontend",
    "build-pkg": "turbo run build --filter=\"./packages/*\"",
    "test": "turbo run test integration-test",
    "test-be": "turbo run test integration-test --filter @oxytype/backend",
    "test-fe": "turbo run test --filter @oxytype/frontend",
    "test-pkg": "turbo run test --filter=\"./packages/*\"",
    "dev": "turbo run dev --force",
    "dev-be": "turbo run dev --force --filter @oxytype/backend",
    "dev-fe": "turbo run dev --force --filter @oxytype/frontend",
    "dev-pkg": "turbo run dev --force --filter=\"./packages/*\"",
    "storybook": "turbo run storybook --force",
    "start": "turbo run start",
    "start-be": "turbo run start --filter @oxytype/backend",
    "start-fe": "turbo run start --filter @oxytype/frontend",
    "docker": "docker compose --env-file docker/.env -f docker/docker-compose.yml up -d",
    "audit-fe": "cd frontend && npm run audit",
    "preview-fe": "oxytype-release --preview-fe",
    "release": "oxytype-release",
    "release-fe": "oxytype-release --fe",
    "release-be": "oxytype-release --be",
    "release-no-deploy": "oxytype-release --no-deploy",
    "release-dry": "oxytype-release --dry",
    "hotfix": "oxytype-release --hotfix",
    "hotfix-fe": "oxytype-release --hotfix --fe",
    "hotfix-be": "oxytype-release --hotfix --be",
    "hotfix-dry": "oxytype-release --hotfix --dry",
    "format-check": "vp fmt . --check",
    "format-fix": "vp fmt .",
    "lint-styles": "stylelint \"**/*.css\"",
    "lint-styles-fix": "stylelint \"**/*.css\" --fix",
    "lint-json-assets": "turbo lint-json --filter @oxytype/frontend",
    "check-assets": "turbo check-assets --filter @oxytype/frontend",
    "check-assets-quotes": "turbo check-assets --filter @oxytype/frontend  -- quotes",
    "check-assets-languages": "turbo check-assets --filter @oxytype/frontend  -- languages",
    "check-assets-others": "turbo check-assets --filter @oxytype/frontend  -- others",
    "knip": "knip",
    "oxlint": "vp lint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@oxytype/release": "workspace:*",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "catalog:",
    "caniuse-lite": "1.0.30001814",
    "conventional-changelog": "8.1.3",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "only-allow": "1.2.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "turbo": "2.11.6",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*": [
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,js}": [
      "vp lint --type-aware --type-check --format agent"
    ],
    "*.css": [
      "stylelint"
    ]
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.8.1"
}
