{
  "name": "@oxytype/challenges",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "npm run madge && vp pack",
    "test": "vp test run",
    "madge": " madge --circular --extensions ts ./src",
    "ts-check": "tsc --noEmit",
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent",
    "george-mapping": "tsx ./scripts/challenge-roles"
  },
  "dependencies": {
    "@oxytype/schemas": "workspace:*"
  },
  "devDependencies": {
    "@oxytype/tsdown-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@types/node": "24.9.1",
    "madge": "8.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
