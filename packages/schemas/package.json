{
  "name": "@monkeytype/schemas",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "npm run madge && vp pack",
    "test": "vp test run",
    "madge": " madge --circular --extensions ts ./src",
    "ts-check": "tsc --noEmit",
    "lint": "vp lint . --type-aware --type-check",
    "lint-fast": "vp lint ."
  },
  "dependencies": {
    "@monkeytype/util": "workspace:*"
  },
  "devDependencies": {
    "@monkeytype/tsup-config": "workspace:*",
    "@monkeytype/typescript-config": "workspace:*",
    "@types/node": "24.9.1",
    "madge": "8.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "zod": "3.23.8"
  }
}
