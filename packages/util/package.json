{
  "name": "@oxytype/util",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "npm run madge && vp pack",
    "test": "vp test run",
    "madge": " madge --circular --extensions ts ./src",
    "ts-check": "tsc --noEmit",
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent"
  },
  "devDependencies": {
    "@oxytype/tsdown-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@types/node": "24",
    "madge": "8.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "4.6.5"
  }
}
