{
  "name": "@oxytype/contracts",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "npm run madge && vp pack",
    "test": "vp test run",
    "madge": " madge --circular --extensions ts ./src",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent"
  },
  "dependencies": {
    "@oxytype/schemas": "workspace:*"
  },
  "devDependencies": {
    "@oxytype/tsdown-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@types/node": "24.19.0",
    "madge": "8.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ts-rest/core": "3.52.1",
    "zod": "4.6.5"
  }
}
