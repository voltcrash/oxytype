{
  "workspaces": {
    "backend": {
      "entry": ["src/worker.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["@oxytype/oxlint-config"],
      "ignoreBinaries": ["dist"]
    },
    "frontend": {
      "entry": [
        "src/ts/index.ts",
        "src/ts/{oauth-callback,not-found,legal-page,standalone-renderer}.tsx",
        "src/ts/types/*.d.ts"
      ],
      "project": "src/ts/**/*.{ts,tsx}",
      "ignore": [
        "src/ts/constants/ignored-keys.ts",
        "src/ts/utils/async-modules.ts",
        "src/ts/utils/debug.ts"
      ],
      "ignoreDependencies": [
        "@oxytype/oxlint-config",
        "@tanstack/eslint-plugin-query",
        "eslint-plugin-compat",
        "eslint-plugin-solid",
        "firebase-tools",
        "normalize.css",
        "balloon-css",
        "tailwindcss",
        "virtual:env-config",
        "virtual:language-hashes"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    },
    "frontend/storybook": {
      "storybook": false,
      "entry": [
        ".storybook/*.{ts,tsx}",
        "stories/**/*.{stories.ts,stories.tsx,mdx}"
      ],
      "project": [".storybook/**/*.{ts,tsx}", "stories/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@storybook/addon-links", "@vitest/coverage-v8"]
    },
    "packages/oxlint-config": {
      "entry": ["plugins/*.js"],
      "project": ["plugins/*.js"]
    }
  },
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "entry": ["commitlint.config.cjs", "stylelint.config.mjs"],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "caniuse-lite",
    "yaml"
  ],
  "ignoreBinaries": ["docker", "tsx"]
}
