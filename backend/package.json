{
  "name": "@oxytype/backend",
  "version": "1.14.3",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent",
    "build": "npm run gen-docs && tsc --build",
    "watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "start": "node ./dist/server.js",
    "test": "vp test run --project=unit",
    "integration-test": "vp test run --project=integration --project=integration-isolated",
    "test-coverage": "vp test run --coverage",
    "dev": "concurrently -p none \"tsx watch --clear-screen=false --inspect ./src/server.ts\" \"tsc --preserveWatchOutput --noEmit --watch\"  \"esw src/ -w --ext .ts --cache --color\"",
    "docker-db-only": "docker compose --env-file .env -f docker/compose.db-only.yml up",
    "docker": "docker compose --env-file .env -f docker/compose.yml up",
    "gen-docs": "tsx scripts/openapi.ts dist/static/api/openapi.json && redocly build-docs -o dist/static/api/internal.html internal@v2 && redocly bundle -o dist/static/api/public.json public-filter && redocly build-docs -o dist/static/api/public.html public@v2",
    "dev:worker": "wrangler dev --port 5005",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:worker": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply oxytype-staging --local",
    "db:migrate:remote": "wrangler d1 migrations apply oxytype-staging --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@date-fns/utc": "2.1.1",
    "@hono/node-server": "2.1.3",
    "@oxytype/challenges": "workspace:*",
    "@oxytype/contracts": "workspace:*",
    "@oxytype/funbox": "workspace:*",
    "@oxytype/schemas": "workspace:*",
    "@oxytype/util": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "chalk": "6.0.1",
    "cron": "4.4.0",
    "date-fns": "4.4.0",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "etag": "1.8.1",
    "hono": "4.13.12",
    "ioredis": "6.0.0",
    "ip-address": "10.7.2",
    "lru-cache": "11.5.3",
    "mongodb": "7.7.0",
    "object-hash": "3.0.0",
    "prom-client": "15.1.3",
    "qs": "6.16.0",
    "rate-limiter-flexible": "11.2.1",
    "simple-git": "4.0.2",
    "string-similarity": "4.0.4",
    "ua-parser-js": "2.0.10",
    "uuid": "14.0.2",
    "winston": "3.19.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@oxytype/oxlint-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@redocly/cli": "2.57.0",
    "@types/bcrypt": "6.0.0",
    "@types/node": "24.19.0",
    "@types/object-hash": "3.0.6",
    "@types/qs": "6.15.1",
    "@types/readline-sync": "1.4.8",
    "@types/string-similarity": "4.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261001.0-alpha",
    "openapi3-ts": "4.6.1",
    "readline-sync": "1.4.10",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.146.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
