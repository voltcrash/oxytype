DB_NAME=oxytype
DOCKER_SERVER_PORT=5005
DOCKER_DB_PORT=27017
DB_URI=mongodb://localhost:27017
DOCKER_REDIS_PORT=6379
REDIS_URI=redis://localhost:6379
LOG_FOLDER_PATH=./logs/
# Default log file max size is 10 MB
LOG_FILE_MAX_SIZE=10485760
MODE=dev
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# You can also use the format mongodb://username:password@host:port or
# uncomment the following lines if you want to define them separately
# DB_USERNAME=
# DB_PASSWORD=
# DB_AUTH_MECHANISM="SCRAM-SHA-256"
# DB_AUTH_SOURCE=admin

# You can get a testing email address over at
# https://ethereal.email/create
#
# EMAIL_PORT=587
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="Oxytype <noreply@yourdomain.com>"
# FRONTEND_URL=https://your-oxytype-domain.example
# DISCORD_CLIENT_ID=your-own-discord-application-id

# Quote approvals need an Oxytype-owned repository checkout and an exact allowed origin URL.
# OXYTYPE_QUOTES_REPO_PATH=/absolute/path/to/oxytype-quotes
# OXYTYPE_QUOTES_REMOTE_URL=git@github.com:your-org/oxytype-quotes.git

# Better Auth: development defaults work on localhost. Required in production.
# Generate once with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5005/auth
FRONTEND_URL=http://localhost:3000
# Optional OAuth. Register BETTER_AUTH_URL/callback/google or /callback/github.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
