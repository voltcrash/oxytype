{
  "name": "@voltcrash/oxytype",
  "version": "26.10.4",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "assets": "bun scripts/bundle-assets.ts",
    "build": "vp run assets && bun scripts/build.ts",
    "package-check": "vp run build && bun scripts/smoke-package.ts",
    "dev": "vp run assets && bun run src/index.tsx",
    "test": "vp run assets && bun test",
    "madge": "madge --circular --extensions ts,tsx ./src",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "lint": "vp run madge && vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@oxytype/challenges": "workspace:*",
    "@oxytype/contracts": "workspace:*",
    "@oxytype/funbox": "workspace:*",
    "@oxytype/schemas": "workspace:*",
    "@oxytype/typing-core": "workspace:*",
    "@oxytype/util": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "solid-js": "1.9.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxytype/typescript-config": "workspace:*",
    "@types/bun": "1.4.2",
    "eslint-plugin-solid": "0.18.0",
    "madge": "8.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "//": "Raw bun only where bun is the runtime (OpenTUI); script-to-script calls use vp run."
}
