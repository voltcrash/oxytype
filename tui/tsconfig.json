{
  "extends": "@oxytype/typescript-config/base.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "src",
    "__tests__",
    "scripts",
    "vite.config.ts",
    "lint.config.ts"
  ],
  "exclude": ["node_modules"]
}
