// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`guest and authenticated account snapshots: guest account 1`] = `
"
 oxytype   test   settings   account   leaderboards   history       serika dark

 not logged in  guest
 config local · 0 queued uploads
















 enter log in  r reconnect
 esc back  ^t test  ^s settings  ^a acct  ^l ranks  ^o history  ^p cmd  ^c quit

"
`;

exports[`guest and authenticated account snapshots: authenticated account 1`] = `
"
 oxytype   test   settings   account   leaderboards   history       serika dark

 Tester  authenticated
 config synced · 0 queued uploads

  tui stats   web stats

 xp     streak       completed    started    time typing
 100    2 (max 3)    7            8          0.0h

 personal bests  0 · page 1/1
 no personal bests yet








 r reconnect  l log out  tab client  ↑↓ PB pages  h history  t tags  p presets
 esc back  ^t test  ^s settings  ^a acct  ^l ranks  ^o history  ^p cmd  ^c quit

"
`;

exports[`populated leaderboard snapshot: leaderboard 1`] = `
"
 oxytype   test   settings   account   leaderboards   history       serika dark

 tab  all-time    c  tui    l  english    m  time 15

   #     name                wpm       acc      raw
 ▌ 1     Tester              100       100.0%   101

 page 1/1 · your rank unranked












 ↑↓ select  ←→ pages  tab board  c client  l language  m test  enter profile
 esc back  ^t test  ^s settings  ^a acct  ^l ranks  ^o history  ^p cmd  ^c quit

"
`;

exports[`saved history detail snapshot: history details 1`] = `
"
 oxytype   test   settings   account   leaderboards   history       serika dark

  local    1 test

 wpm    acc
 ▀▀█    █▀█ ▀█  ▀ █
