# Copy to frontend/.env for local development or set these variables in the build environment.
BACKEND_URL=http://localhost:5005
# Cloudflare test widget for local development. Production builds require a real site key.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Production builds without BACKEND_URL use same-origin /api. Set this to your Oxytype API URL for separate hosting.
# BACKEND_URL=https://your-api.example.com

# Optional Oxytype-owned Sentry project. No telemetry is sent without a DSN.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
